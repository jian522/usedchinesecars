
<section class="page-header">
    <div class="container">
        <h1><%= __('about_title') %></h1>
        <p><%= __('about_subtitle') %></p>
    </div>
</section>

<section class="section about-content">
    <div class="container">
        <div class="about-grid">
            <div class="about-text">
                <h2><%= __('about_mission') %></h2>
                <p><%= __('about_mission_text') %></p>

                <h2><%= __('about_why_us') %></h2>
                <ul class="about-features">
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> <%= __('about_point_1') %></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> <%= __('about_point_2') %></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> <%= __('about_point_3') %></li>
                    <li><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> <%= __('about_point_4') %></li>
                </ul>
            </div>
            <div class="about-contact-card">
                <h3><%= __('contact_us') %></h3>
                <div class="contact-detail">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                    <span><%= settings.phone %></span>
                </div>
                <div class="contact-detail">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                    <span><%= settings.email %></span>
                </div>
                <div class="contact-detail">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                    <span><%= settings['address_' + lang] || settings.address_zh %></span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Stats Bar -->
<section class="stats-bar">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <span class="stat-number"><%= stats.totalCars %><span class="stat-plus">+</span></span>
                <span class="stat-label"><%= __('stat_cars') %></span>
            </div>
            <div class="stat-item">
                <span class="stat-number"><%= stats.totalCountries %><span class="stat-plus">+</span></span>
                <span class="stat-label"><%= __('stat_countries') %></span>
            </div>
            <div class="stat-item">
                <span class="stat-number">10<span class="stat-plus">+</span></span>
                <span class="stat-label"><%= __('stat_years') %></span>
            </div>
            <div class="stat-item">
                <span class="stat-number">99<span class="stat-plus">%</span></span>
                <span class="stat-label"><%= __('stat_satisfaction') %></span>
            </div>
        </div>
    </div>
</section>

<% if (testimonials && testimonials.length > 0) { %>
<section class="section testimonials-section" id="testimonials">
    <div class="container">
        <div class="section-header">
            <div>
                <h2><%= __('home_testimonials') || '客户评价' %></h2>
                <p><%= __('home_testimonials_desc') || '来自全球客户的真实反馈' %></p>
            </div>
        </div>
        <div class="testimonials-grid">
            <% testimonials.forEach(t => { %>
                <div class="testimonial-card">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-quote">"<%= t['quote_' + lang] || t.quote_zh || t.quote_en %>"</p>
                    <div class="testimonial-author">
                        <% if (t.image_url && !t.image_url.startsWith('data:')) { %>
                            <img src="<%= t.image_url %>" alt="<%= t.name %>" loading="lazy" width="48" height="48">
                        <% } else { %>
                            <div class="testimonial-avatar"><%= t.name.charAt(0) %></div>
                        <% } %>
                        <div>
                            <strong><%= t.name %></strong>
                            <span><%= t.role %></span>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>
