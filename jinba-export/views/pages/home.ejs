<!-- Hero Carousel -->
<section class="hero-carousel">
    <div class="carousel-track" id="carouselTrack">
        <% carousel.forEach((slide, i) => { %>
            <div class="carousel-slide <%= i === 0 ? 'active' : '' %>" style="background-image: url('<%= slide.image_url %>')">
                <div class="slide-overlay"></div>
                <div class="slide-content container">
                    <h1><%= slide['title_' + lang] || slide.title_zh %></h1>
                    <p><%= slide['description_' + lang] || slide.description_zh %></p>
                    <a href="/<%= slide.button_link %>" class="btn btn-gold"><%= slide['button_text_' + lang] || slide.button_text_zh %></a>
                </div>
            </div>
        <% }) %>
    </div>
    <div class="carousel-dots" id="carouselDots"></div>
    <button class="carousel-arrow prev" id="carouselPrev"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg></button>
    <button class="carousel-arrow next" id="carouselNext"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg></button>
</section>

<!-- Stats Bar -->
<section class="stats-bar">
    <div class="container">
        <div class="stats-grid">
            <div class="stat-item">
                <span class="stat-number"><%= stats.totalCars %><span class="stat-plus">+</span></span>
                <span class="stat-label"><%= __('stat_cars') %></span>
            </div>
            <div class="stat-item">
                <span class="stat-number"><%= stats.totalCountries %><span class="stat-plus">+</span></span>
                <span class="stat-label"><%= __('stat_countries') %></span>
            </div>
            <div class="stat-item">
                <span class="stat-number">10<span class="stat-plus">+</span></span>
                <span class="stat-label"><%= __('stat_years') %></span>
            </div>
            <div class="stat-item">
                <span class="stat-number">99<span class="stat-plus">%</span></span>
                <span class="stat-label"><%= __('stat_satisfaction') %></span>
            </div>
        </div>
    </div>
</section>

<!-- Featured Cars -->
<section class="section featured-cars">
    <div class="container">
        <div class="section-header">
            <h2><%= __('home_featured') %></h2>
            <a href="/cars?featured=1" class="link-more"><%= __('view_all') %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
        <div class="car-grid">
            <% featured.forEach(car => { %>
                <%- include('../partials/car_card', { car }) %>
            <% }) %>
        </div>
    </div>
</section>

<!-- Countries Section (placeholder for Phase 4 map) -->
<section class="section countries-preview">
    <div class="container">
        <div class="section-header">
            <h2><%= __('home_countries') %></h2>
            <a href="/about" class="link-more"><%= __('view_all') %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
        <div class="country-grid">
            <% countries.slice(0, 6).forEach(c => { %>
                <div class="country-card">
                    <div class="country-flag">
                        <img src="https://flagcdn.com/w80/<%= c.iso_code.toLowerCase() %>.png"
                             srcset="https://flagcdn.com/w160/<%= c.iso_code.toLowerCase() %>.png 2x"
                             alt="<%= c.name_en %>" loading="lazy" width="40" height="30">
                    </div>
                    <h3><%= c['name_' + lang] || c.name_zh %></h3>
                    <span class="country-volume"><%= c.trade_volume %></span>
                </div>
            <% }) %>
        </div>
    </div>
</section>

<!-- New Arrivals -->
<section class="section new-arrivals bg-light">
    <div class="container">
        <div class="section-header">
            <h2><%= __('home_new_arrivals') %></h2>
            <a href="/cars?newArrival=1" class="link-more"><%= __('view_all') %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
        <div class="car-grid">
            <% newArrivals.forEach(car => { %>
                <%- include('../partials/car_card', { car }) %>
            <% }) %>
        </div>
    </div>
</section>

<!-- Testimonials -->
<% if (testimonials && testimonials.length > 0) { %>
<section class="section testimonials-section">
    <div class="container">
        <div class="section-header">
            <div>
                <h2><%= __('home_testimonials') || '客户评价' %></h2>
                <p><%= __('home_testimonials_desc') || '来自全球客户的真实反馈' %></p>
            </div>
            <a href="/about#testimonials" class="link-more"><%= __('view_all') %> <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
        </div>
        <div class="testimonials-grid">
            <% testimonials.forEach(t => { %>
                <div class="testimonial-card">
                    <div class="testimonial-stars">★★★★★</div>
                    <p class="testimonial-quote">"<%= t['quote_' + lang] || t.quote_zh || t.quote_en %>"</p>
                    <div class="testimonial-author">
                        <% if (t.image_url && !t.image_url.startsWith('data:')) { %>
                            <img src="<%= t.image_url %>" alt="<%= t.name %>" loading="lazy" width="48" height="48">
                        <% } else { %>
                            <div class="testimonial-avatar"><%= t.name.charAt(0) %></div>
                        <% } %>
                        <div>
                            <strong><%= t.name %></strong>
                            <span><%= t.role %></span>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    </div>
</section>
<% } %>

<!-- Trust Bar -->
<section class="trust-bar">
    <div class="container">
        <div class="trust-grid">
            <div class="trust-item">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <h4><%= __('trust_quality') %></h4>
                <p><%= __('trust_quality_desc') %></p>
            </div>
            <div class="trust-item">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <h4><%= __('trust_secure') %></h4>
                <p><%= __('trust_secure_desc') %></p>
            </div>
            <div class="trust-item">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                <h4><%= __('trust_fast') %></h4>
                <p><%= __('trust_fast_desc') %></p>
            </div>
            <div class="trust-item">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <h4><%= __('trust_support') %></h4>
                <p><%= __('trust_support_desc') %></p>
            </div>
        </div>
    </div>
</section>
