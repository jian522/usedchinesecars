
<section class="car-detail">
    <div class="container">
        <div class="car-detail-grid">
            <!-- Image Gallery -->
            <div class="car-gallery" data-images='<%- JSON.stringify(car.images) %>'>
                <div class="gallery-main">
                    <% const primary = car.images?.find(im => im.is_primary) || car.images?.[0]; %>
                    <% if (primary) { %>
                        <img src="<%= primary.url %>" alt="<%= car.brand %> <%= car.model %>">
                    <% } %>
                </div>
                <% if (car.images && car.images.length > 1) { %>
                    <div class="gallery-thumbs">
                        <% car.images.forEach(im => { %>
                            <img src="<%= im.url %>" alt="" class="gallery-thumb <%= im.is_primary ? 'active' : '' %>">
                        <% }) %>
                    </div>
                <% } %>
            </div>

            <!-- Car Info -->
            <div class="car-info">
                <div class="car-info-header">
                    <h1><%= car.brand %> <%= car.model %></h1>
                    <div class="car-badges">
                        <% if (car.is_featured) { %><span class="badge badge-featured"><%= __('badge_featured') %></span><% } %>
                        <% if (car.is_new_arrival) { %><span class="badge badge-new"><%= __('badge_new') %></span><% } %>
                    </div>
                </div>

                <div class="car-price-large"><%= __('currency_symbol') %><%= car.price.toLocaleString() %></div>

                <div class="car-specs">
                    <div class="spec-item"><span class="spec-label"><%= __('spec_year') %></span><span class="spec-value"><%= car.year %></span></div>
                    <div class="spec-item"><span class="spec-label"><%= __('spec_mileage') %></span><span class="spec-value"><%= car.mileage.toLocaleString() %> km</span></div>
                    <div class="spec-item"><span class="spec-label"><%= __('spec_fuel') %></span><span class="spec-value"><%= car.fuel_type %></span></div>
                    <div class="spec-item"><span class="spec-label"><%= __('spec_transmission') %></span><span class="spec-value"><%= car.transmission %></span></div>
                </div>

                <div class="car-description">
                    <h3><%= __('car_description') %></h3>
                    <p><%= car['description_' + lang] || car.description_zh || car.description_en || __('no_description') %></p>
                </div>

                <div class="car-actions">
                    <a href="#inquiryForm" class="btn btn-gold btn-lg"><%= __('inquire_now') %></a>
                    <a href="https://wa.me/<%= settings.phone %>?text=<%= encodeURIComponent(__('whatsapp_template').replace('{brand}', car.brand).replace('{model}', car.model).replace('{year}', car.year).replace('{price}', __('currency_symbol') + car.price.toLocaleString()).replace('{url}', 'https://jinbacars.com/cars/' + car.id)) %>" class="btn btn-whatsapp btn-lg" target="_blank" rel="noopener">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                        WhatsApp
                    </a>
                </div>

                <!-- Social Share -->
                <div class="social-share">
                    <span class="social-share-label">Share:</span>
                    <a href="https://wa.me/?text=<%= encodeURIComponent(car.brand + ' ' + car.model + ' - ' + __('currency_symbol') + car.price.toLocaleString() + ' https://jinbacars.com/cars/' + car.id) %>" target="_blank" rel="noopener" class="social-share-link" aria-label="Share on WhatsApp">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                    </a>
                    <a href="https://t.me/share/url?url=https://jinbacars.com/cars/<%= car.id %>&text=<%= encodeURIComponent(car.brand + ' ' + car.model) %>" target="_blank" rel="noopener" class="social-share-link" aria-label="Share on Telegram">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.127.087.499.087.499l-1.484 7.027c-.103.464-.424.611-.812.48l-3.686-1.206c-.396-.127-.404-.39-.087-.592l2.71-1.82c.316-.212.251-.355.064-.461-.188-.106-.308-.077-.308-.077l-4.202 2.707c-.377.21-.716.154-.894-.12-.112-.176-.137-.324-.163-.475l-.62-2.042-.062-.02c-.366-.07-.94-.246-.93-.576.008-.253.377-.502 1.112-.755 4.442-1.874 5.906-2.422 6.748-2.636.507-.134.788-.098 1.046.083.298.211.193.514.067.664-.126.15-.737.765-.737.765l-2.525 2.367c-.443.395-.127.738-.058.795.143.119.228.105.228.105l3.694-1.203c.362-.116.696.065.656.392 0 0-.18.86-.31 1.344l-.508 1.796c-.116.408-.334.488-.527.528" fillRule="evenodd"/></svg>
                    </a>
                    <a href="https://www.facebook.com/sharer/sharer.php?u=https://jinbacars.com/cars/<%= car.id %>" target="_blank" rel="noopener" class="social-share-link" aria-label="Share on Facebook">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
                    </a>
                    <a href="https://twitter.com/intent/tweet?text=<%= encodeURIComponent(car.brand + ' ' + car.model + ' - Used car export') %>&url=https://jinbacars.com/cars/<%= car.id %>" target="_blank" rel="noopener" class="social-share-link" aria-label="Share on Twitter/X">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                    </a>
                </div>

                <!-- Inline Inquiry Form -->
                <div class="car-inquiry-form" id="inquiryForm">
                    <h3><%= __('inquiry_title') %></h3>
                    <form class="inquiry-form" id="carInquiryForm">
                        <input type="hidden" name="car_model" value="<%= car.brand %> <%= car.model %> (<%= car.year %>)">
                        <div class="form-group">
                            <label for="inq_name"><%= __('form_name') %> *</label>
                            <input type="text" id="inq_name" name="name" required>
                        </div>
                        <div class="form-row">
                            <div class="form-group">
                                <label for="inq_email"><%= __('form_email') %> *</label>
                                <input type="email" id="inq_email" name="email" required>
                            </div>
                            <div class="form-group">
                                <label for="inq_phone"><%= __('form_phone') %></label>
                                <input type="tel" id="inq_phone" name="phone">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="inq_message"><%= __('form_message') %> *</label>
                            <textarea id="inq_message" name="message" rows="3" placeholder="<%= __('inquiry_placeholder') %>"><%= __('inquiry_default_msg').replace('{brand}', car.brand).replace('{model}', car.model) %></textarea>
                        </div>
                        <!-- Honeypot -->
                        <div style="position:absolute;left:-9999px" aria-hidden="true">
                            <input type="text" name="website" tabindex="-1" autocomplete="off">
                        </div>
                        <button type="submit" class="btn btn-gold btn-lg btn-block"><%= __('form_submit') %></button>
                        <p class="form-feedback" id="inquiryFeedback"></p>
                    </form>
                </div>
            </div>
        </div>

        <!-- Related Cars -->
        <% if (related && related.length > 0) { %>
            <div class="section related-cars">
                <h2><%= __('related_cars') %></h2>
                <div class="car-grid">
                    <% related.forEach(car => { %>
                        <%- include('../partials/car_card', { car }) %>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>
</section>
