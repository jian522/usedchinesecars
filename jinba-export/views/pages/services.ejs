
<section class="page-header">
    <div class="container">
        <h1><%= __('services_title') %></h1>
        <p><%= __('services_subtitle') %></p>
    </div>
</section>

<section class="section services-content">
    <div class="container">
        <div class="services-grid">
            <div class="service-card" id="export">
                <div class="service-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="1.5"><path d="M12 2l9 4.5v3c0 5.3-3.8 10.3-9 11.5C6.8 19.8 3 14.8 3 9.5v-3L12 2z"/></svg></div>
                <h3><%= __('svc_export_title') %></h3>
                <p><%= __('svc_export_desc') %></p>
            </div>
            <div class="service-card" id="logistics">
                <div class="service-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="1.5"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg></div>
                <h3><%= __('svc_logistics_title') %></h3>
                <p><%= __('svc_logistics_desc') %></p>
            </div>
            <div class="service-card" id="customs">
                <div class="service-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg></div>
                <h3><%= __('svc_customs_title') %></h3>
                <p><%= __('svc_customs_desc') %></p>
            </div>
            <div class="service-card" id="inspection">
                <div class="service-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="1.5"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>
                <h3><%= __('svc_inspection_title') %></h3>
                <p><%= __('svc_inspection_desc') %></p>
            </div>
            <div class="service-card" id="finance">
                <div class="service-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="1.5"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></div>
                <h3><%= __('svc_finance_title') %></h3>
                <p><%= __('svc_finance_desc') %></p>
            </div>
            <div class="service-card" id="aftersales">
                <div class="service-icon"><svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#b8860b" stroke-width="1.5"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg></div>
                <h3><%= __('svc_aftersales_title') %></h3>
                <p><%= __('svc_aftersales_desc') %></p>
            </div>
        </div>
    </div>
</section>
