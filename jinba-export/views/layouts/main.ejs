<!DOCTYPE html>
<html lang="<%= htmlLang %>" dir="<%= dir %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : __('meta_description') %>">
    <meta name="keywords" content="<%= __('meta_keywords') %>">

    <!-- Open Graph -->
    <meta property="og:title" content="<%= typeof ogTitle !== 'undefined' ? ogTitle : (typeof title !== 'undefined' ? title + ' - ' : '') + __('site_name') %>">
    <meta property="og:description" content="<%= typeof ogDescription !== 'undefined' ? ogDescription : (typeof metaDescription !== 'undefined' ? metaDescription : __('meta_description')) %>">
    <meta property="og:image" content="<%= typeof ogImage !== 'undefined' ? ogImage : '' %>">
    <meta property="og:url" content="<%= typeof ogUrl !== 'undefined' ? ogUrl : '' %>">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="<%= __('site_name') %>">
    <title><%= typeof title !== 'undefined' ? title + ' - ' : '' %><%= __('site_name') %></title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet">

    <link rel="canonical" href="<%= typeof canonicalUrl !== 'undefined' ? canonicalUrl : '' %>">

    <% if (typeof settings !== 'undefined' && settings.ga_id) { %>
    <!-- Google Analytics -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=<%= settings.ga_id %>"></script>
    <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= settings.ga_id %>');
    </script>
    <% } %>

    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/design-tokens.css">
    <link rel="stylesheet" href="/css/main.css">
    <% if (typeof extraCSS !== 'undefined') { %>
        <%- extraCSS %>
    <% } %>
</head>
<body class="<%= dir === 'rtl' ? 'rtl' : '' %>">
    <%- include('../partials/header') %>

    <main>
        <%- body %>
    </main>

    <%- include('../partials/footer') %>

    <script src="/js/i18n.js"></script>
    <script src="/js/main.js"></script>
    <% if (typeof extraJS !== 'undefined') { %>
        <%- extraJS %>
    <% } %>
</body>
</html>
