<!DOCTYPE html>
<html lang="<%= htmlLang %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Login - Jinba Export</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+SC:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/reset.css">
    <link rel="stylesheet" href="/css/design-tokens.css">
    <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-login-page">
    <div class="login-container">
        <div class="login-logo">
            <svg width="48" height="48" viewBox="0 0 32 32" fill="none"><rect width="32" height="32" rx="6" fill="#1a2744"/><path d="M8 16L11 12L20 21L15 24L8 16Z" fill="#b8860b"/><path d="M16 8L21 12L17 20L12 16L16 8Z" fill="#d4a745"/></svg>
            <span>Jinba Admin</span>
        </div>
        <form method="POST" action="/admin/login" class="login-form">
            <% if (error) { %>
                <div class="form-error"><%= error %></div>
            <% } %>
            <div class="form-group">
                <label for="username">Username</label>
                <input type="text" id="username" name="username" required autofocus>
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Sign In</button>
        </form>
    </div>
</body>
</html>
